<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#0D1B2A">

    <!-- Top Title + Download -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz Over!"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:gravity="center"/>

        <ImageButton
            android:id="@+id/btnDownloadReport"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:background="@drawable/ic_download_circle"
            android:backgroundTint="#FFD700"
            android:src="@drawable/ic_download"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:elevation="10dp"
            android:contentDescription="Download Report"/>
    </FrameLayout>

    <!-- Player Name Card -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:background="@drawable/player_name_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:text="Congratulations,"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvPlayerName"
            android:text="ASHIF ALI ANSARI"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:shadowColor="#FFD700"
            android:shadowRadius="8"/>
    </LinearLayout>

    <!-- Score Circle -->
    <RelativeLayout
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginBottom="10dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_gold_border"/>

        <TextView
            android:id="@+id/tvFinalScore"
            android:text="12/15"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- Percentage -->
    <TextView
        android:id="@+id/tvPercentage"
        android:text="80%"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginBottom="10dp"/>

    <!-- Message -->
    <TextView
        android:id="@+id/tvMessage"
        android:text="Excellent!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#FFD700"
        android:shadowRadius="10"
        android:layout_marginBottom="30dp"/>

    <!-- Play Again -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="40dp"
        android:text="🔄 Play Again"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0D1B2A"
        app:backgroundTint="#FFD700"
        app:cornerRadius="16dp"
        app:elevation="10dp"/>

</LinearLayout>
