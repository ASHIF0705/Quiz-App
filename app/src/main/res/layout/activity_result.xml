<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="15dp"
    android:background="#0D1B2A">

    <!-- Quiz Over with Confetti -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉 Quiz Over! 🎉"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

    </LinearLayout>

    <!-- Player Name - Premium Style -->
    <LinearLayout
        android:layout_width="377dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:background="@drawable/player_name_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Congratulations,"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:shadowColor="#FFD700"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:text="ASHIF ALI ANSARI"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="32sp" />
    </LinearLayout>

    <!-- Score Circle (Only Score inside) -->
    <RelativeLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginBottom="30dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_gold_border" />

        <TextView
            android:id="@+id/tvFinalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12/15"
            android:textSize="50sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Percentage (Big, Below Circle) -->
    <TextView
        android:id="@+id/tvPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80%"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginBottom="20dp" />

    <!-- Dynamic Message - Same Font Style as Player Name (No Card) -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excellent!"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#FFD700"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="12"
        android:letterSpacing="0.05"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="50dp"
        android:gravity="center" />

    <!-- Play Again Button -->
    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play Again"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D1B2A"
        android:backgroundTint="#FFD700"
        android:padding="18dp"
        android:elevation="10dp"
        android:layout_marginHorizontal="20dp" />

</LinearLayout>